#
# ior.cmake  umbrella for IOR/MDTEST hpc benchmarks
# 30-Jan-2026  chuck@ece.cmu.edu
#

#
# config:
#  IOR_REPO - url of git repository
#  IOR_TAG  - tag to checkout of git
#  IOR_TAR  - cache tar file name (default should be ok)
#
#  IOR_RDMA - add a depend on rdma-core to ensure we build with it
#

if (NOT TARGET ior)

#
# umbrella option variables
#
umbrella_defineopt (IOR_REPO "https://github.com/hpc/ior.git"
                    STRING "IOR GIT repository")
umbrella_defineopt (IOR_TAG "main" STRING "IOR GIT tag")
umbrella_defineopt (IOR_TAR "ior-${IOR_TAG}.tar.gz" STRING "IOR cache tar file")

umbrella_defineopt (IOR_RDMA "OFF" BOOL "have ior depend on rdma-core")

#
# XXX: ior main (post 4.0) requires autoconf >= 2.71, but our
# rocky9 image comes with 2.69 as the default autoconf install.
# rocky9 offers a "autoconf2.7x" package that provides a
# "autoreconf27" command that should do the trick, but the ior
# bootstrap shell script won't know to use that.   we can bypass
# the shell script and run autoreconf or autoreconf27 in the
# prepare step to work around this (assume that "autoconf2.7x"
# can be installed).
#
# XXX:
# an alternate idea is build a new autoconf/automake using the
# umbrella bootstrap and add that to the front of our path.   but
# the problem with this is that the new aclocal generated by the
# umbrella bootstrap will not look in the normal place for m4 macros
# (since the prefix is different) and so it won't find the pkg.m4
# macros that ior needs -- and results in a confusing error msg:
#   configure.ac:91: error: possibly undefined macro: AC_DEFINE
#   configure.ac:403: error: possibly undefined macro: AC_SUBST
# so this gets to be a mess too.   stick with the autoreconf27
# option for now...
#

# get autoconf version
execute_process(COMMAND autoconf --version
                COMMAND head -1
                OUTPUT_VARIABLE autoconf_ver)
string(REGEX MATCH "([0-9]+)\\.([0-9]+)" autoconf_ver ${autoconf_ver})

set(ior_autoreconf_cmd autoreconf)
if ("${autoconf_ver}" STREQUAL "")
    message(FATAL_ERROR "cannot get version# of autoconf\n"
        "is autoconf command installed in the PATH?\n")
elseif("${autoconf_ver}" VERSION_LESS "2.71")
    find_program(IOR_AUTORECONF27 NAMES autoreconf27)
    if (IOR_AUTORECONF27)
        set(ior_autoreconf_cmd autoreconf27)
        message(STATUS "  ior: using autoreconf27 for prepare")
    else()
        message(FATAL_ERROR "ior needs autoconf 2.71 or better\n"
            "current version: ${autoconf_ver}\n"
            "can you install autoconf2.7x package?")
    endif()
endif()

unset(ior_depend)
if (IOR_RDMA)
    include(umbrella/rdma-core)
    set(ior_depend rdma-core)
endif()


#
# generate parts of the ExternalProject_Add args...
#
umbrella_download (IOR_DOWNLOAD ior ${IOR_TAR}
                   GIT_REPOSITORY ${IOR_REPO}
                   GIT_TAG ${IOR_TAG})
umbrella_patchcheck (IOR_PATCHCMD ior)

#
# create ior target
#
ExternalProject_Add (ior DEPENDS ${ior_depend}
    ${IOR_DOWNLOAD} ${IOR_PATCHCMD}
    CONFIGURE_COMMAND <SOURCE_DIR>/configure ${UMBRELLA_COMP}
                      ${UMBRELLA_CPPFLAGS} ${UMBRELLA_LDFLAGS}
                      --prefix=${CMAKE_INSTALL_PREFIX}
    UPDATE_COMMAND "")

#
# add extra autogen prepare step
#
ExternalProject_Add_Step (ior prepare
    COMMAND ${ior_autoreconf_cmd} -ivf
    COMMENT "preparing source for configure"
    DEPENDEES update
    DEPENDERS configure
    WORKING_DIRECTORY <SOURCE_DIR>)

endif (NOT TARGET ior)
